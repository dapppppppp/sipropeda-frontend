{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "module": "esnext", // atau 'commonjs'
    "target": "ESNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    // "paths": {
    //   "*": ["node_modules/*"],
    // }
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  }
}